# Copy to .env and fill in the key for the provider you intend to use.
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# Vulcan reads exactly one of these, chosen by the `provider:` key in your config.

# ── provider: openai ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional: override for Azure OpenAI or a proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── provider: anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── provider: gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── provider: openai_compatible ─────────────────────────────────────────────
# Any OpenAI-compatible server: vLLM, SGLang, Ollama, llama.cpp, TGI, LM Studio.
# Most local servers ignore the key, but the field must be non-empty.
VULCAN_API_KEY=EMPTY
VULCAN_BASE_URL=http://localhost:8000/v1
