# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# Type checkers / linters
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# Credentials — never commit these.
# Vulcan reads provider API keys from the environment or from a local .env file.
.env
.env.*
!.env.example
*credentials*.json
*api_key*
*.pem

# Pipeline output. Runs write generated code, trajectories and datasets here;
# none of it belongs in version control.
outputs/
vulcan_output/
vulcan_datagen_output/
*.jsonl.gz

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
